generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  password  String
  role      String   // COURIER, CUSTOMER, GOVERNMENT
  name      String
  iin       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  courierProfile  CourierProfile?
  ordersCreated   Order[] @relation("CustomerOrders")
  ordersAccepted  Order[] @relation("CourierOrders")
}

model CourierProfile {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehiclePlate String
  vehicleBrand String
  lastLat      Float?
  lastLng      Float?
  lastUpdate   DateTime?
}

model Order {
  id            String   @id @default(uuid())
  customerId    String
  customer      User     @relation("CustomerOrders", fields: [customerId], references: [id])
  courierId     String?
  courier       User?    @relation("CourierOrders", fields: [courierId], references: [id])
  status        String   // PENDING, ACCEPTED, IN_TRANSIT, DELIVERED, CANCELLED
  
  // Destination
  destLat       Float?
  destLng       Float?
  destAddress   String
  
  // Item
  description   String
  price         Float
  photoUrl      String?
  
  // Hackathon features
  requiresRefrigeration Boolean @default(false)
  isRemoteVillage       Boolean @default(false)

  // Route Data
  routeGeometry String?  // Stores 2GIS polyline
  distance      Float?
  estimatedTime Float?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  transactions  Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Float
  status    String   // COMPLETED, PENDING
  createdAt DateTime @default(now())
}
